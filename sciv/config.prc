win-size 1920 1080
model-path assets/models
framebuffer-srgb 0

x-wm-class openciv
x-wm-class-name OpenCiv

#default-bin opaque,10

#threading-model Cull
yield-timeslice #f
#client-sleep 0.002
clock-mode normal

#garbage-collect-states-rate 60.0

tk-main-loop false
window-title OpenCiv
state-cache 1
garbage-collect-states 0

want-directtools false
want-tk false
pstats-python-profiler 1
pstats-gpu-timing 1

sync-video #f
hardware-animated-vertices true
basic-shaders-only false
flatten-collision-nodes 1
sampler-object-limit 16086
sort-geom true 
geom-cache-size 20000
flatten-collision-nodes 1
framebuffer-float 0
framebuffer-multisample 0
multisamples 0