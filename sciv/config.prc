
win-size 1920 1080
model-path assets/models
framebuffer-srgb 0
hardware-animated-vertices true
basic-shaders-only false
flatten-collision-nodes 1
sampler-object-limit 16086
#default-bin opaque,10
#sort-geom true 
x-wm-class openciv
x-wm-class-name OpenCiv
sync-video #f
#want-directtools true
#want-tk true
#threading-model Cull
yield-timeslice #f
client-sleep 0.002
clock-mode normal
flatten-collision-nodes 1
#garbage-collect-states-rate 60.0
geom-cache-size 20000
tk-main-loop false
window-title OpenCiv